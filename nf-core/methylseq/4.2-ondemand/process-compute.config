// Compute overrides for nf-core/methylseq 4.2.0 on Cirro.
// Starts from Cirro's public config (retry any failed task up to 2 times) and adds
// larger, uninterruptible (On-Demand) resources for the long-running genome index
// and alignment steps of both the bwa-meth and Bismark workflows.
//
// CPU:RAM ratios follow Cirro's guidance (1:4 general purpose, 1:8 memory optimized).
// Tasks not listed here keep the pipeline defaults (conf/base.config) on the Spot queue.

profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 2

            // ---------------- bwa-meth workflow ----------------

            // Built once per run when no prebuilt bwa-meth index exists (true for iGenomes
            // mm10/GRCm38). With use_mem2, a BWA-MEM2 index of the doubled (C->T / G->A)
            // genome needs roughly 150 GB of RAM.
            withName: 'BWAMETH_INDEX' {
                cpus   = 24
                memory = 192.GB
                time   = 24.h
                queue  = "${PW_ONDEMAND_JOB_QUEUE}"
            }

            // bwa-meth uses every CPU it is given (-t task.cpus).
            withName: 'BWAMETH_ALIGN' {
                cpus   = 48
                memory = 192.GB
                time   = 3.d
                queue  = "${PW_ONDEMAND_JOB_QUEUE}"
            }

            // ---------------- Bismark workflow ----------------

            // Only runs when no prebuilt Bismark index exists (iGenomes GRCm38/mm10 have one).
            withName: 'BISMARK_GENOMEPREPARATION' {
                cpus   = 16
                memory = 128.GB
                time   = 24.h
                queue  = "${PW_ONDEMAND_JOB_QUEUE}"
            }

            // The module sets --multicore = min(cpus / 3, memory / 13 GB)
            // (cpus / 5 and memory / 18 GB when non-directional).
            // 48 CPUs and 192 GB give --multicore 14 for a directional EM-seq library.
            withName: 'BISMARK_ALIGN' {
                cpus   = 48
                memory = 192.GB
                time   = 5.d
                queue  = "${PW_ONDEMAND_JOB_QUEUE}"
            }

            // Deduplication and methylation extraction of ~350M-pair samples also run for hours.
            withName: 'BISMARK_DEDUPLICATE' {
                cpus   = 8
                memory = 64.GB
                time   = 2.d
                queue  = "${PW_ONDEMAND_JOB_QUEUE}"
            }
            withName: 'BISMARK_METHYLATIONEXTRACTOR' {
                cpus   = 16
                memory = 64.GB
                time   = 2.d
                queue  = "${PW_ONDEMAND_JOB_QUEUE}"
            }
        }
    }
}
